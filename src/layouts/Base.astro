---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  date?: Date;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og.png",
  date
} = Astro.props;

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site) : Astro.url;
const publishedTime = date ? new Date(date).toISOString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" id="theme-color" content="#13161a" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog | Abdelwahab Mahmoud"
      href="/rss.xml"
    />

    <meta
      property="og:type"
      content={Astro.url.pathname.startsWith("/blog/") ? "article" : "website"}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:alt" content={ogTitle} />
    {
      Astro.url.pathname.startsWith("/blog/") && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={ogTitle} />
    <meta property="twitter:description" content={ogDescription} />
    <meta property="twitter:image" content={new URL(ogImage, site).href} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <script is:inline>
      (function () {
        var theme = localStorage.getItem("theme");
        if (theme !== "light" && theme !== "dark") theme = "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-PNVK2LGZM4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-PNVK2LGZM4");
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="cwd" href="/">~/abdelwahab</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/#experience">./experience</a>
          <a href="/#products">./products</a>
          <a href="/#stack">./stack</a>
          <a href="/#opensource">./open-source</a>
          <a class="nav-blog" href="/blog">./blog</a>
          <a href="/#contact">./contact</a>
          <button
            id="theme-toggle"
            class="theme-toggle"
            aria-label="Toggle theme"
            data-track="theme-toggle"
          >
            <span class="toggle-dark">[light]</span>
            <span class="toggle-light">[dark]</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© 2026 Abdelwahab Mahmoud</span>
        <span>built with astro · hosted on github pages</span>
      </div>
    </footer>

    <script is:inline data-track-target="theme-toggle">
      function applyThemeColor(theme) {
        var meta = document.getElementById("theme-color");
        if (meta)
          meta.setAttribute(
            "content",
            theme === "dark" ? "#13161a" : "#f7f6f2"
          );
      }
      applyThemeColor(document.documentElement.dataset.theme);
      var toggle = document.getElementById("theme-toggle");
      if (toggle) {
        toggle.addEventListener("click", function () {
          var theme =
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark";
          document.documentElement.dataset.theme = theme;
          localStorage.setItem("theme", theme);
          applyThemeColor(theme);
        });
      }
      document.addEventListener("click", function (event) {
        var el = event.target.closest("[data-track]");
        if (!el) return;
        window.gtag &&
          window.gtag("event", "click", {
            hitType: "event",
            event_category: "Reached",
            event_label: el.getAttribute("data-track")
          });
      });
    </script>
  </body>
</html>
