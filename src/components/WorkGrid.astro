---
import ArrowUpRight from "./ArrowUpRight.astro";
import {workChallenges} from "../data/portfolio";

const {title, subtitle, footer, cards} = workChallenges;
---

<section class="container section" id="work">
  <div class="section-head">
    <h2 class="section-title">{title}</h2>
  </div>
  <p class="section-lede">{subtitle}</p>

  <ul class="work-grid">
    {
      cards.map(card => (
        <li class="work-cell">
          <button
            type="button"
            class="work-card"
            data-challenge={card.id}
            aria-haspopup="dialog"
          >
            <h3 class="work-card-title">{card.title}</h3>
            <p class="work-card-summary">{card.summary}</p>
            <span class="work-card-more">
              How I approach it <span class="arrow">→</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <p class="work-foot">
    {footer}
    <a class="link-arrow" href="/work">Browse all work</a>
    <a class="link-arrow" href="#contact">Tell me what you're building.</a>
  </p>

  {
    cards.map(card => (
      <dialog
        class="work-dialog"
        id={`challenge-${card.id}`}
        aria-labelledby={`challenge-${card.id}-title`}
      >
        <div class="work-dialog-inner">
          <div class="work-dialog-top">
            <h3 class="work-dialog-title" id={`challenge-${card.id}-title`}>
              {card.title}
            </h3>
            <form method="dialog">
              <button class="work-close" aria-label="Close">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  width="20"
                  height="20"
                  aria-hidden="true"
                >
                  <path d="M5 5l10 10M15 5 5 15" />
                </svg>
              </button>
            </form>
          </div>
          <p class="work-dialog-lede">{card.summary}</p>

          <h4 class="work-dialog-h">What it covers</h4>
          <ul class="work-covers">
            {card.covers.map(item => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="work-dialog-foot">
            {card.project && (
              <a
                class="btn"
                href={card.project.url}
                target="_blank"
                rel="noreferrer"
              >
                {card.project.name} <ArrowUpRight />
              </a>
            )}
            {card.article ? (
              <a class="btn btn-primary" href={`/blog/${card.article}`}>
                Read the full write-up <ArrowUpRight />
              </a>
            ) : (
              <span class="work-soon">Full write-up coming soon</span>
            )}
          </div>
        </div>
      </dialog>
    ))
  }

  <script>
    document.querySelectorAll<HTMLElement>("[data-challenge]").forEach(card => {
      card.addEventListener("click", () => {
        const dialog = document.getElementById(
          `challenge-${card.dataset.challenge}`
        ) as HTMLDialogElement | null;
        dialog?.showModal();
      });
    });

    document
      .querySelectorAll<HTMLDialogElement>("dialog.work-dialog")
      .forEach(dialog => {
        dialog.addEventListener("click", event => {
          if (event.target === dialog) dialog.close();
        });
      });
  </script>
</section>
