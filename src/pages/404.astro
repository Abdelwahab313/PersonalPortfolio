---
import Base from "../layouts/Base.astro";

const title = "404 | Abdelwahab Mahmoud";
const description = "Page not found.";
---

<Base {title} {description}>
  <main class="not-found">
    <p class="preamble">$ pwd</p>
    <h1>404: not found</h1>
    <p>That path is not in this filesystem.</p>
    <a href="/">cd ~</a>
  </main>
</Base>
