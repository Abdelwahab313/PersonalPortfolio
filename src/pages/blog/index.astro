---
import Base from "../../layouts/Base.astro";
import {getCollection} from "astro:content";

const posts = (
  await getCollection("blog", ({data}) =>
    import.meta.env.PROD ? data.status === "published" : true
  )
).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.data.order - b.data.order
);

const KIND_LABEL = {"case-study": "Case study", note: "Note"};
const title = "Blog | Abdelwahab Mahmoud";
const description =
  "Case studies and notes from eight years building production systems. What was there, what I decided, what it cost, and what changed.";
---

<Base {title} {description}>
  <div class="blog-main">
    <p class="preamble">
      $ ls ./blog <span class="comment"># notes and case studies</span>
    </p>
    <header class="blog-head">
      <h1 class="blog-title">Writing</h1>
      <p class="blog-subtitle">
        Notes and case studies from building production systems. What was tried,
        what cost, and what changed.
      </p>
    </header>

    <ul class="post-list">
      {
        posts.map(post => (
          <li class="post-row">
            <div class="post-meta">
              <time datetime={post.data.date.toISOString().slice(0, 10)}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              <span class="post-kind">{KIND_LABEL[post.data.kind]}</span>
              {post.data.status === "draft" && (
                <span class="post-draft">Draft</span>
              )}
            </div>
            <a class="post-row-title" href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
            <p class="post-lede">{post.data.lede}</p>
            <ul class="post-tags">
              {post.data.tags.map(tag => (
                <li class="post-tag">{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
